# Cloudflare proxies to this origin with SSL mode Full; Caddy gets a Let's Encrypt certificate over HTTP-01.
whatyousignupfor.us {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
	log {
		output file /var/log/caddy/consent.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}

www.whatyousignupfor.us {
	redir https://whatyousignupfor.us{uri} permanent
}
