# Server configuration. In production this lives in /etc/consent/env (mode 640, root:consent).
# Never commit real values. Every integration is optional: leave its key empty and the feature is off.

# Required
PUBLIC_URL=https://whatyousignupfor.us
# One ID, or a comma separated list (unpacked developer build, Chrome Web Store build)
EXTENSION_ID=legohnmopgodooidnpmfajmiopenlogl
GEMINI_API_KEY=

# Runtime
DATA_DIR=/var/lib/consent
PORT=3000
GEMINI_MODEL=gemini-3.5-flash-lite
# 1 gives every signed in account the Pro features and hides billing
FREE_PRO=1
# Local development over plain http only
INSECURE_COOKIES=

# Listen (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# Terms change tracker (Tiger Data / TimescaleDB connection string)
TIGER_DATABASE_URL=

# Continue with Google (Auth0 regular web application; callback PUBLIC_URL/auth/callback)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Billing (Stripe). Test keys only: the server refuses live keys unless ALLOW_LIVE_STRIPE=1.
# Create the price and webhook with: node server/deploy/stripe-setup.mjs https://your.site
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
ALLOW_LIVE_STRIPE=
